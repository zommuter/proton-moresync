[Unit]
Description=proton-moresync contacts+calendar backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Personal config (PROTON_USER=you@proton.me) lives in ~/.config/proton-moresync/env,
# which is not committed. Create it with: make install
EnvironmentFile=%h/.config/proton-moresync/env
ExecStart=%h/src/proton-moresync/proton-backup-sync.sh
TimeoutStartSec=10min
