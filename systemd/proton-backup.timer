[Unit]
Description=Daily proton-moresync contacts+calendar backup

[Timer]
OnCalendar=daily
# Spread load by up to 1h after midnight so all machines don't hammer Proton at once.
RandomizedDelaySec=1h
# Fire immediately on the next boot if the last scheduled run was missed
# (e.g. machine was off at midnight).
Persistent=true

[Install]
WantedBy=timers.target
